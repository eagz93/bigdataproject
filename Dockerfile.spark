
FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       openjdk-17-jdk-headless \
       curl \
       procps \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=python3
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-spark.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-spark.txt

COPY notebooks/          ./notebooks/
COPY extract_data.py     \
     generar_graficas.py \
     train_model.py      \
     scheduler.py        \
     crontab             \
     docker-entrypoint.spark.sh ./

RUN sed -i 's/\r$//' docker-entrypoint.spark.sh \
    && chmod +x docker-entrypoint.spark.sh

RUN mkdir -p /app/data \
             /app/source_data \
             /app/logs \
             /app/informe/img

HEALTHCHECK --interval=60s --timeout=10s --start-period=1200s --retries=20 \
    CMD test -f /app/data/plan_reabastecimiento_csv/_SUCCESS || exit 1

ENTRYPOINT ["./docker-entrypoint.spark.sh"]
CMD ["python", "scheduler.py"]
